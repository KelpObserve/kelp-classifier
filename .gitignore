# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- venvs / editor / OS ----
.venv*/
venv/
.env
.DS_Store
.idea/
.vscode/

# ---- ALL data + derivatives (users bring their own) ----
data/
logs/
tmp/
backups/
*.h5
*.npz
*.ckpt
*.pt

# ---- Raw source pulls under data_collection/ ----
data_collection/gbif/*.csv
data_collection/gbif/*.tsv
data_collection/obis/*.csv
data_collection/obis/*.json
data_collection/jncc/*.csv
data_collection/jncc/*.mdb
data_collection/source_statistics.csv

# ---- Exploratory / other sources (kept only for the pull script) ----
data_collection/other_sources_tried/*
!data_collection/other_sources_tried/*.py
!data_collection/other_sources_tried/*.md

# ---- Pipeline outputs (regenerable) ----
training/splits/*.json
training/splits/*.txt
training/results/

# ---- Backups / legacy leftovers ----
*.backup*
*.legacy_*
*.pre_*bak
*.pre_b02match

# ---- Runtime scratch ----
*.log

# Licensed imagery must never be reintroduced.
training/results_submerged/*_over_pneo.png

# Published deployment artifacts; other generated heads remain ignored.
!training/results/
training/results/*
!training/results/pool_sweep_metrics.png
!training/results/head_single_p1/
training/results/head_single_p1/*
!training/results/head_single_p1/model.pt
!training/results/head_single_p1/results.json
!training/results_submerged/head_single_p1/model.pt
!training/results_submerged/head_single_p5/model.pt
!training/results_submerged/head_single_pixel/model.pt
!training/splits/split_single.json
